# —— Web（web，端口 3020）——
# NEXT_PUBLIC_API_BASE=/api
# API_INTERNAL_BASE=http://127.0.0.1:8020   # 与 API_PORT 一致
# CANONICAL_HOST=

# —— API（api，端口 8020）——
# 元库（账号/设置等，SQLite）：默认 <server>/data/meta.db
# SNS_META_DB=        # 可选：自定义 SQLite 文件路径
# SNS_CONFIG=          # 默认 <server>/config/app.json
# Cookie 的 Secure 属性默认按请求协议自动判断（HTTPS 自动开启）；
# 仅当反向代理没有传递 X-Forwarded-Proto 时才需要显式设置 0/1。
# SNS_COOKIE_SECURE=0
# SNS_CORS_ORIGINS=
# 色花 / Bitmagnet 资源库 DSN：设置页或 config/app.local.json（resource_db / bitmagnet_db）

# —— RexHub 原生能力（api/app/rexhub）——
# REXHUB_DATA_DIR=     # 默认 <server>/data/rexhub
# REXHUB_CORS_ORIGINS=
