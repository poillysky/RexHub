# 服务参数（TMDB / LLM / 翻译 / 网盘 / 搜索服务）全部在 PWA 设置页写入元库，
# 不再从环境变量读取。这里只列仍然有效的运行时变量。

# 元库（账号/设置等，SQLite）：默认 <server>/data/meta.db
# SNS_META_DB=
# SNS_CONFIG=
# Cookie 的 Secure 属性默认按请求协议自动判断（HTTPS 自动开启）；
# 仅当反向代理没有传递 X-Forwarded-Proto 时才需要显式设置 0/1。
# SNS_COOKIE_SECURE=0
# SNS_CORS_ORIGINS=

# —— RexHub 原生能力 ——
# REXHUB_DATA_DIR=
# REXHUB_CORS_ORIGINS=
# NODE_BIN=
# PYTHON_BIN=
# REXHUB_P115_EXTRACT_DIR=
