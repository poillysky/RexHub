# —— Web（apps/web，端口 3020）——
# NEXT_PUBLIC_API_BASE=/api
# API_INTERNAL_BASE=http://127.0.0.1:8787   # 与 API_PORT 一致
# CANONICAL_HOST=

# —— API（apps/api，端口 8787）——
# 元库（账号/设置等，SQLite）：默认 <仓库根>/data/meta.db
# SNS_META_DB=        # 可选：自定义 SQLite 文件路径
# SNS_CONFIG=          # 默认 <仓库根>/config/app.json
# SNS_COOKIE_SECURE=0
# 色花 / Bitmagnet 资源库 DSN：设置页或 config/app.local.json（resource_db / bitmagnet_db）

# —— RexHub 原生能力（apps/api/app/rexhub）——
# REXHUB_DATA_DIR=     # 默认 <仓库根>/data/rexhub
# REXHUB_TOKEN_TTL=2592000
# REXHUB_CORS_ORIGINS=
# REXHUB_COOKIE_SECURE=0
